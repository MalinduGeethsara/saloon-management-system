generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  imageUrl  String?
  googleId  String?  @unique
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Payroll & Commission Fields
  salaryType     String   @default("Commission") // Fixed, Commission, Hybrid
  baseSalary     Float    @default(0)
  commissionRate Float    @default(0) // Percentage (e.g., 50 for 50%)
  allowances     Float    @default(0) // Fixed monthly allowances (LKR)

  // Foreign Keys
  shopId    String?

  // Relations
  shop               Shop?           @relation("ShopStaff", fields: [shopId], references: [id])
  bookingsAsCustomer Booking[]       @relation("CustomerBookings")
  bookingsAsBarber   Booking[]       @relation("BarberBookings")
  attendance         Attendance[]
  payroll            Payroll[]
  payments           Payment[]
  permissions        StaffPermission[]
  notifications      Notification[]
  employeeDevices    EmployeeDevice[]
}

model Shop {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  imageUrl  String?
  status           String   @default("Open") // Open, Closed, Renovating
  operatingHours   Json?    // e.g. { "Monday": { "open": "09:00", "close": "18:00", "isClosed": false }, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings  Booking[]
  staff     User[]    @relation("ShopStaff")
  services  Service[]
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    Int      // Duration in minutes
  imageUrl    String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  shopId      String?

  // Relations
  shop        Shop?    @relation(fields: [shopId], references: [id])
  bookings    BookingService[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  brand       String?
  category    String?
  sku         String?  @unique
  description String?
  price       Float
  stock       Int      @default(0)
  imageUrl    String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(uuid())
  date        DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Foreign Keys
  customerId  String
  barberId    String?
  shopId      String?

  // Relations
  customer    User             @relation("CustomerBookings", fields: [customerId], references: [id])
  barber      User?            @relation("BarberBookings", fields: [barberId], references: [id])
  services    BookingService[]
  shop        Shop?            @relation(fields: [shopId], references: [id])
  payment     Payment?

  @@index([date, status])
  @@index([shopId])
  @@index([createdAt])
}

model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid())
  amount      Float
  status      PaymentStatus @default(PENDING)
  method      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // nullable — walk-in payments have no booking or registered customer
  bookingId   String?  @unique
  customerId  String?
  clientName  String?
  clientPhone String?
  barberName  String?
  items       Json?

  // Relations
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  customer    User?     @relation(fields: [customerId], references: [id])

  @@index([createdAt, status])
}

model Attendance {
  id          String   @id @default(uuid())
  date        DateTime
  checkIn     DateTime
  checkOut    DateTime?
  method      String   @default("MANUAL")  // MANUAL | FINGERPRINT
  deviceId    String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  userId      String

  // Relations
  user        User     @relation(fields: [userId], references: [id])
}

model EmployeeDevice {
  id            String   @id @default(uuid())
  fingerprintId String   @db.VarChar(100)
  deviceId      String   @db.VarChar(100)
  deviceName    String?
  status        String   @default("ACTIVE")  // ACTIVE | REVOKED
  registeredAt  DateTime @default(now())

  // Foreign Keys
  userId        String

  // Relations
  user          User     @relation(fields: [userId], references: [id])

  @@unique([fingerprintId, deviceId])
}

model Payroll {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  baseSalary  Float
  bonus       Float?   @default(0)
  totalAmount Float
  status      String   @default("PENDING") // PENDING, PAID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign Keys
  userId      String

  // Relations
  user        User     @relation(fields: [userId], references: [id])

  @@index([month, year, status])
  @@index([createdAt])
}

model StaffPermission {
  id        String   @id @default(uuid())
  userId    String
  pageKey   String   @db.VarChar(50)
  canView   Boolean  @default(false)
  canAdd    Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
}

enum OtpPurpose {
  REGISTER
  LOGIN
  PASSWORD_RESET
  ADD_PHONE
}

model OtpCode {
  id         String     @id @default(uuid())
  identifier String     @db.VarChar(191) // normalized email or phone
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(191) // HMAC-SHA256(code, SESSION_SECRET) — raw code is never stored
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  desc      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

