DATABASE_URL="mysql://root:@localhost:3306/saloon_management"
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"
# Do NOT set NODE_ENV here. `next dev` / `next start` set it themselves and the session
# cookie's `secure` flag depends on it being "production" in prod.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

RESEND_API_KEY="your-resend-api-key-here"
RESEND_FROM_EMAIL="MR POLAA <bookings@your-domain.com>"

NOTIFYLK_USER_ID="your-notifylk-user-id"
NOTIFYLK_API_KEY="your-notifylk-api-key"
NOTIFYLK_SENDER_ID="NotifyDEMO"

PAYHERE_MERCHANT_ID="your-payhere-merchant-id"
PAYHERE_MERCHANT_SECRET="your-payhere-merchant-secret"
PAYHERE_MODE="sandbox"

FINGERPRINT_DEVICE_KEY="change-this-to-a-long-random-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First accounts, created by: node --env-file=.env prisma/create-owner.js
# Fill in the ones you need (email + name are required; a random password is generated and printed once if you
# leave it empty). An email that already has an account is never changed. AFTER it ran, delete the *_PASSWORD
# lines: the database keeps only a hash, so no plain-text password should stay on the server.
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""
OWNER_PHONE=""
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
ADMIN_PHONE=""

# Only used by prisma/seed.js (refuses to run in production unless ALLOW_PROD_SEED=true)
SEED_DEFAULT_PASSWORD=""
ALLOW_PROD_SEED=""

# Optional: extra mobile numbers (comma separated) that get an SMS for every staff booking alert,
# in addition to the owner/manager/barber phones saved on their accounts
STAFF_SMS_EXTRA_NUMBERS=""

# Optional: extra email addresses (comma separated) that get the owner emails (new bookings, product
# orders, refunds needed ...) in addition to the email of every account with the OWNER role
OWNER_ALERT_EMAILS=""
