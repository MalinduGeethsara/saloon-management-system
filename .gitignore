# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/selenium-tests/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database dumps and load-test artifacts (real user data / plaintext test passwords)
*.sql
/load-testing/*.csv
/load-testing/*.log
/load-testing/*.txt
/load-testing/results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA run output (results, mock gateway log, server logs)
/qa/results/
